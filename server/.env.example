# =============================================
# SERVER CONFIG
# =============================================
PORT=5000
NODE_ENV=development

# =============================================
# DATABASE
# =============================================
# MongoDB (example)
# =============================================
# DATABASE (XAMPP - MySQL / MariaDB)
# =============================================
# Default XAMPP settings:
# Host: localhost
# Port: 3306 (default MySQL port)
# User: root (default)
# Password: (blank by default in XAMPP)
# Database Name: Create one in phpMyAdmin (e.g., 'tickethub_db')
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# If you want to use a connection URL format (for Sequelize or TypeORM):
# DATABASE_URL=mysql://root:@localhost:3306/tickethub_db
# =============================================
# AUTHENTICATION & SECURITY
# =============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# =============================================
# FLUTTERWAVE (Secret Keys - Backend Only)
# =============================================
# Find these in your Flutterwave Dashboard -> Settings -> API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE_xxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_xxxxxxxxxxxxxxxxxx # (Public goes to frontend, but keep secret keys secure)
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_ENCRYPT_xxxxxxxxxx  # Required for Flutterwave standard payment flows
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_verify_token

# =============================================
# GEOCODING / MAPS API
# =============================================
GEOCODE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================
# EMAIL (for contact form)
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@tickethub.com

# =============================================
# FRONTEND URL (for CORS)
# =============================================
FRONTEND_URL=http://localhost:3000